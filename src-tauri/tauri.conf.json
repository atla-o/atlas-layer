{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas Layer",
  "version": "0.1.0",
  "identifier": "rehab.atlas.layer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:47331",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Atlas Layer",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
