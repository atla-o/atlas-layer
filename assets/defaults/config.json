{
  "office": {
    "title": "Atlas Layer"
  },
  "features": {
    "office": true,
    "filter": false,
    "sharedCompute": false
  },
  "paths": {
    "todo": "~/Atla/AI/todo.json",
    "today": "~/Atla/AI/atla-today.json",
    "personality": "~/Atla/AI/personality.md",
    "inboxDir": "~/Atla/AI/office-inbox",
    "inboxFile": "",
    "historyDir": ""
  },
  "ollama": {
    "baseUrl": "http://127.0.0.1:11434",
    "model": "qwen3:8b",
    "echoIfUnavailable": false
  },
  "relay": {
    "url": "",
    "urlEnv": "ATLAS_LAYER_WEBHOOK_URL",
    "authEnv": "ATLAS_LAYER_WEBHOOK_AUTH",
    "authKeyringAccount": "webhook-auth"
  },
  "localWindow": {
    "inboxDir": "~/Atla/AI/inbox",
    "launchCommand": ""
  },
  "cursor": {
    "baseUrl": "https://api.cursor.com",
    "apiKeyEnv": "CURSOR_API_KEY",
    "apiKeyKeyringAccount": "cursor-api-key",
    "auth": "bearer",
    "pollSeconds": 60
  }
}
